# --- LiteLLM gateway (model access) -----------------------------------------
KB_LLM_BASE_URL=http://localhost:4000/v1
KB_LLM_API_KEY=sk-your-litellm-virtual-key
KB_LLM_MODEL=claude-opus-5

# --- Agent limits ------------------------------------------------------------
KB_MAX_AGENT_STEPS=12
KB_MAX_RECORDS_PER_RUN=2000

# --- API ---------------------------------------------------------------------
KB_API_PORT=8000
KB_DEFAULT_PRINCIPAL=anonymous

# --- Source credentials (read by the MCP servers, not by the platform) -------
JIRA_URL=https://your-org.atlassian.net
JIRA_USERNAME=you@example.com
JIRA_API_TOKEN=
CONFLUENCE_URL=https://your-org.atlassian.net/wiki
GITHUB_TOKEN=
